# ─────────────────────────────────────────────────────────────────────────────
# Copiar este archivo a .env.local y completar valores
#   cp env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ─── Variables expuestas al cliente (prefijo VITE_) ──────────────────────────

# Supabase (cliente)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ey...

# Stripe (clave pública)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare Stream (subdominio para reproductor)
VITE_CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-xxxxx.cloudflarestream.com

# URL base del API (en local Vite proxy, en prod /api)
VITE_API_BASE_URL=/api

# ─── Secrets — SOLO Vercel Functions (NO usar VITE_) ─────────────────────────

# Supabase service role (bypass RLS — solo en server)
SUPABASE_SERVICE_ROLE_KEY=ey...

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare Stream (API token con permiso Stream:Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=escuela-riqueza-assets
